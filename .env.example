# ===========================================================================
# .env.example — copia in .env e personalizza. NON committare il .env reale.
# Le variabili sono lette dai moduli (es. italian_llm.data.synthetic) in modo
# lazy: se non impostate, il sistema ricade sul MOCK teacher (nessuna rete).
# ===========================================================================

# --- Teacher per la generazione dati sintetici ----------------------------
# Provider attivo: "mock" (default, offline e deterministico),
# "openai_compat" (qualsiasi endpoint OpenAI-compatibile), "hf_local" (pipeline HF locale).
TEACHER_PROVIDER=mock

# Endpoint OpenAI-compatibile (vLLM, TGI, OpenAI, Together, ...). Lascia vuoto per mock.
TEACHER_BASE_URL=
# Chiave API del provider sopra. Lascia vuoto per mock.
TEACHER_API_KEY=
# Nome del modello teacher lato provider (es. "qwen2.5-72b-instruct"). Vuoto per mock.
TEACHER_MODEL=

# --- HuggingFace ----------------------------------------------------------
# Token HF per scaricare modelli gated/privati. Lascia vuoto per modelli pubblici/locali.
HF_TOKEN=

# --- Weights & Biases (logging esperimenti, opzionale) --------------------
# Chiave W&B. Se vuota e WANDB_MODE=offline, i log restano locali.
WANDB_API_KEY=
# "offline" (default consigliato), "online" oppure "disabled".
WANDB_MODE=offline

# --- GPU ------------------------------------------------------------------
# Indici GPU visibili al processo (es. "0", "0,1"). Su host senza GPU e' ignorato.
CUDA_VISIBLE_DEVICES=0
